# Trapnex Backend Configuration

# Server Configuration
PORT=3001
NODE_ENV=development

# ============================================
# MARKET DATA PLATFORM SELECTION
# ============================================
# Choose your platform: tradingview, angelone, upstox, or zerodha
# Default: tradingview (works instantly with demo mode)
MARKET_PLATFORM=tradingview

# ============================================
# TRADINGVIEW CREDENTIALS - RECOMMENDED
# ============================================
# ✅ Works instantly with demo mode - no credentials needed!
# Get API access from: https://www.tradingview.com/pricing/ (Pro+ or Premium)

# Symbol to track (format: EXCHANGE:SYMBOL)
# Examples:
#   Indian Markets: NSE:NIFTY, NSE:BANKNIFTY, BSE:SENSEX
#   Crypto: BINANCE:BTCUSDT, COINBASE:ETHUSD
#   US Markets: NASDAQ:AAPL, NYSE:TSLA
TRADINGVIEW_SYMBOL=NSE:NIFTY

# Optional: API Key for real-time data (leave empty for demo mode)
TRADINGVIEW_API_KEY=

# Optional: Resolution/timeframe (1, 5, 15, 30, 60, etc.)
TRADINGVIEW_RESOLUTION=1

# ============================================
# ANGELONE (SmartAPI) CREDENTIALS
# ============================================
# Get your credentials from: https://smartapi.angelbroking.com/
ANGELONE_API_KEY=your_angelone_api_key
ANGELONE_CLIENT_ID=your_client_id
ANGELONE_PASSWORD=your_password

# AngelOne Instrument Token for NIFTY 50 (default: 99926000)
# Find tokens at: https://margincalculator.angelbroking.com/OpenAPI_File/files/OpenAPIScripMaster.json
ANGELONE_INSTRUMENT_TOKEN=99926000

# ============================================
# UPSTOX CREDENTIALS
# ============================================
# Get your access token from: https://api.upstox.com/
UPSTOX_API_KEY=your_api_key
UPSTOX_API_SECRET=your_api_secret
UPSTOX_ACCESS_TOKEN=your_access_token
UPSTOX_REDIRECT_URI=http://localhost:3001/callback

# Upstox Instrument Key for NIFTY 50 (default: NSE_INDEX|Nifty 50)
UPSTOX_INSTRUMENT_KEY=NSE_INDEX|Nifty 50

# ============================================
# ZERODHA (KITE) CREDENTIALS
# ============================================
# Get your credentials from: https://kite.trade/
ZERODHA_API_KEY=your_zerodha_api_key
ZERODHA_ACCESS_TOKEN=your_zerodha_access_token

# Zerodha Instrument Token for NIFTY 50 (default: 256265)
# Find tokens at: https://api.kite.trade/instruments
ZERODHA_INSTRUMENT_TOKEN=256265

# ============================================
# TELEGRAM BOT (OPTIONAL)
# ============================================
# Telegram (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
